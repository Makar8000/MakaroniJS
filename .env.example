# The Discord Bot token
DISCORD_TOKEN="<TOKEN>"
# The Discord Bot application ID
DISCORD_APP_ID="<APP_ID>"
# The Discord Bot user ID
DISCORD_USER_ID="<USER_ID>"
# The Discord User token
## For special user-only endpoints
DISCORD_USER_TOKEN="<USER_TOKEN>"

# Bot settings
## Prefix to require for message commands
MESSAGE_PREFIX="!"
## Status (online, invisible, etc)
DISCORD_BOT_STATUS="online"
## (optional) Directory for the SQLite databases. Defaults to ./data
# DATA_DIR="./data"

# Internal Services
## The base url of the running MakaroniHTTP instance
INTERNAL_API_URL="http://127.0.0.1:3000"
## Auth header value
INTERNAL_API_AUTH="Basic <BASE64_ENCODED>"

# External Services
## Used to access the GitHub API
GITHUB_TOKEN="<TOKEN>"
## Used to access the XIVAPI
XIVAPI_TOKEN="<TOKEN>"
## Used for LLM services
OPENROUTER_MODEL="<MODEL_NAME>"
OPENROUTER_API_KEY="<API_KEY>"
## Used for Watch2Gether
W2G_KEY="<API_KEY>"
## Used for Consumet
ANIME_PROVIDER="<PROVIDER_NAME>"