{
  "name": "makaronijs",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun index.ts",
    "prod": "pm2 start \"bun index.ts\" --name makaroni --log data/Makaroni.log",
    "stop": "pm2 stop makaroni",
    "monitor": "pm2 logs makaroni",
    "restart": "git pull && bun install --frozen-lockfile && pm2 restart makaroni --update-env",
    "deploy-commands": "bun utils/deploy-commands.ts",
    "deploy-commands-local": "bun utils/deploy-commands.ts --local",
    "remove-commands": "bun utils/deploy-commands.ts --remove",
    "remove-commands-local": "bun utils/deploy-commands.ts --remove --local",
    "check": "tsc",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@openrouter/sdk": "^1.4.21",
    "discord.js": "^14.27.0",
    "node-schedule": "^2.1.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "@types/node-schedule": "^2.1.8",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@openrouter/sdk"
  ]
}
