{
  "tasks": {
    "start": "deno run --env-file --allow-net --allow-read --allow-write=data --allow-env --allow-ffi --allow-sys index.ts",
    "prod": "pm2 start index.ts --name makaroni --log data/Makaroni.log --interpreter deno --interpreter-args \"run --env-file --allow-net --allow-read --allow-write=data --allow-env --allow-ffi --allow-sys\"",
    "stop": "pm2 stop makaroni",
    "monitor": "pm2 logs makaroni",
    "restart": "git pull && deno install --frozen && pm2 restart makaroni --update-env",
    "deploy-commands": "deno run --env-file -A utils/deploy-commands.ts",
    "deploy-commands-local": "deno task deploy-commands --local",
    "remove-commands": "deno task deploy-commands --remove",
    "remove-commands-local": "deno task deploy-commands --remove --local"
  },
  "imports": {
    "@consumet/extensions": "npm:@consumet/extensions@^1.8.8",
    "@octokit/plugin-retry": "npm:@octokit/plugin-retry@^8.1.1",
    "@octokit/plugin-throttling": "npm:@octokit/plugin-throttling@^11.0.5",
    "@octokit/rest": "npm:@octokit/rest@^22.0.1",
    "@openrouter/sdk": "npm:@openrouter/sdk@^1.4.21",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "better-sqlite3": "npm:better-sqlite3@^13.0.3",
    "discord.js": "npm:discord.js@^14.27.0",
    "moment": "npm:moment@^2.31.0",
    "moment-timezone": "npm:moment-timezone@^0.6.5",
    "node-schedule": "npm:node-schedule@^2.1.1",
    "pino": "npm:pino@^10.4.0",
    "pino-pretty": "npm:pino-pretty@^13.2.0"
  },
  "nodeModulesDir": "auto",
  "allowScripts": [
    "npm:better-sqlite3",
    "npm:@openrouter/sdk"
  ],
  "lint": {
    "exclude": [
      "test/",
      "data/"
    ]
  },
  "fmt": {
    "lineWidth": 150
  }
}
